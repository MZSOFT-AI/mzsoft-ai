rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'djelloulmohamed1990@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isAdmin() { 
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    function canManageUsers() {
      return isSuperAdmin() || (isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canManageUsers == true);
    }

    function hasPermission(perm) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[perm] == true)
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    function isValidPermissions(perms) {
      return perms.keys().hasAll(['canManageStock', 'canDeleteProducts', 'canSell', 'canProcessReturns', 'canPerformInventory', 'canManageExpenses', 'canViewReports', 'canManageUsers'])
        && perms.canManageStock is bool
        && perms.canDeleteProducts is bool
        && perms.canSell is bool
        && perms.canProcessReturns is bool
        && perms.canPerformInventory is bool
        && perms.canManageExpenses is bool
        && perms.canViewReports is bool
        && perms.canManageUsers is bool;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'role'])
        && data.displayName is string && data.displayName.size() <= 128
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 128) || data.email == null)
        && data.role in ['superadmin', 'admin', 'vendeur', 'manager']
        && (!data.keys().hasAny(['status']) || data.status in ['active', 'inactive'])
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp || data.createdAt is string || data.createdAt is map)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp || data.updatedAt is string || data.updatedAt is map)
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string || data.photoURL == null))
        && (!data.keys().hasAny(['isLocalOnly']) || data.isLocalOnly is bool)
        && (!data.keys().hasAny(['username']) || (data.username is string && data.username.size() <= 64))
        && (!data.keys().hasAny(['localPassword']) || (data.localPassword is string && data.localPassword.size() <= 64))
        && (!data.keys().hasAny(['uid']) || data.uid is string)
        && (!data.keys().hasAny(['id']) || data.id is string)
        && (!data.keys().hasAny(['permissions']) || isValidPermissions(data.permissions));
    }

    match /users/{userId} {
      allow list: if (request.query.limit <= 1) || isAdmin();
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin() || (resource == null) || (resource != null && (resource.data.username != null || resource.data.email != null));
      
      allow create: if (
        isAdmin() ||
        (!isSignedIn() && incoming().role == 'superadmin') ||
        (isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid)
      ) && isValidUser(incoming());

      allow update: if (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'localPassword', 'uid', 'lastLogoutAt'])) || canManageUsers();
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // PRODUCTS (INVENTORY)
    // ---------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'categoryId', 'purchasePrice', 'sellingPrice', 'stockQuantity'])
        && data.name is string && data.name.size() <= 200
        && data.categoryId is string && isValidId(data.categoryId)
        && data.purchasePrice is number && data.purchasePrice >= 0
        && data.sellingPrice is number && data.sellingPrice >= 0
        && data.stockQuantity is number
        && (!data.keys().hasAny(['sku']) || (data.sku is string || data.sku == null))
        && (!data.keys().hasAny(['barcode']) || (data.barcode is string || data.barcode == null))
        && (!data.keys().hasAny(['minStock']) || (data.minStock is number || data.minStock == null))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time);
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if hasPermission('canManageStock');
      allow update: if hasPermission('canManageStock') || (
        hasPermission('canSell') && incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
      );
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // SALES
    // ---------------------------------------------------------
    function isValidSale(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'paymentMethod', 'status'])
        && (data.userId == request.auth.uid || isAdmin())
        && data.items is list && data.items.size() > 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentMethod in ['cash', 'card', 'transfer', 'credit']
        && data.status in ['completed', 'refunded', 'returned', 'partially_returned']
        && (!data.keys().hasAny(['userName']) || data.userName is string)
        && (!data.keys().hasAny(['customerName']) || data.customerName is string)
        && (!data.keys().hasAny(['customerId']) || (data.customerId is string || data.customerId == null))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time);
    }

    match /sales/{saleId} {
      allow get: if isSignedIn() && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || (request.query.limit <= 500 && request.auth.uid != null));
      allow create: if hasPermission('canSell') && isValidSale(incoming());
      allow update: if hasPermission('canProcessReturns') || (
        isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'updatedAt'])
      );
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // DAILY CLOSINGS
    // ---------------------------------------------------------
    match /daily_closings/{closingId} {
      allow list, get: if isSignedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn(); // Session opening often starts as a creation by current user
      allow update: if isSignedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // PENDING SALES
    // ---------------------------------------------------------
    function isValidPendingSale(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount'])
        && (data.userId == request.auth.uid || isAdmin())
        && data.items is list
        && data.totalAmount is number
        && (!data.keys().hasAny(['userName']) || data.userName is string)
        && (!data.keys().hasAny(['customerName']) || data.customerName is string)
        && (!data.keys().hasAny(['customerId']) || (data.customerId is string || data.customerId == null))
        && (!data.keys().hasAny(['discount']) || data.discount is number)
        && (!data.keys().hasAny(['subtotal']) || data.subtotal is number)
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp || data.createdAt == request.time))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time)
        && (!data.keys().hasAny(['isAutoSave']) || data.isAutoSave is bool);
    }

    match /pending_sales/{saleId} {
      allow read: if isSignedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidPendingSale(incoming());
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // CUSTOMERS - HARDENED
    // ---------------------------------------------------------
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'totalSpent'])
        && data.name is string && data.name.size() <= 200
        && data.totalSpent is number
        && (!data.keys().hasAny(['totalPaid']) || data.totalPaid is number)
        && (!data.keys().hasAny(['totalDebt']) || data.totalDebt is number)
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp || data.updatedAt == request.time))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp || data.createdAt == request.time));
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || hasPermission('canSell')) && isValidCustomer(incoming());
      allow update: if isSignedIn() && (isAdmin() || hasPermission('canSell')) && isValidCustomer(incoming());
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // SUPPLIERS
    // ---------------------------------------------------------
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('canManageStock') || isAdmin();
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // CATEGORIES
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if hasPermission('canManageStock') || isAdmin();
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // EXPENSES
    // ---------------------------------------------------------
    match /expenses/{expenseId} {
      allow list, get: if isAdmin() || hasPermission('canManageExpenses');
      allow create: if hasPermission('canManageExpenses') || isAdmin();
      allow update: if isAdmin();
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // STOCK MOVEMENTS
    // ---------------------------------------------------------
    match /stock_movements/{movementId} {
      allow read: if isSignedIn() && (isAdmin() || hasPermission('canManageStock'));
      allow create: if hasPermission('canSell') || hasPermission('canManageStock') || isAdmin();
      allow update: if isAdmin();
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // REPORTS / SETTINGS
    // ---------------------------------------------------------
    function isValidSettings(data) {
      return data.keys().hasAll(['name', 'currency', 'currencySymbol'])
        && data.name is string && data.name.size() <= 128
        && data.currency is string && data.currency.size() <= 10
        && data.currencySymbol is string && data.currencySymbol.size() <= 10
        && (!data.keys().hasAny(['logo']) || data.logo is string)
        && (!data.keys().hasAny(['slogan']) || data.slogan is string)
        && (!data.keys().hasAny(['address']) || data.address is string)
        && (!data.keys().hasAny(['phone']) || data.phone is string)
        && (!data.keys().hasAny(['email']) || data.email is string)
        && (!data.keys().hasAny(['nif']) || data.nif is string)
        && (!data.keys().hasAny(['rc']) || data.rc is string)
        && (!data.keys().hasAny(['tva']) || data.tva is string)
        && (!data.keys().hasAny(['footerText']) || data.footerText is string)
        && (!data.keys().hasAny(['lockSessions']) || data.lockSessions is bool)
        && (!data.keys().hasAny(['notifyLowStock']) || data.notifyLowStock is bool)
        && (!data.keys().hasAny(['notifyStockDiscrepancy']) || data.notifyStockDiscrepancy is bool)
        && (!data.keys().hasAny(['notifyCashDiscrepancy']) || data.notifyCashDiscrepancy is bool)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    // ---------------------------------------------------------
    // INVOICES - HARDENED
    // ---------------------------------------------------------
    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'userId', 'items', 'totalAmount', 'status', 'paymentStatus', 'createdAt'])
        && data.invoiceNumber is string && data.invoiceNumber.size() <= 64
        && data.items is list && data.items.size() > 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['draft', 'validated', 'paid', 'cancelled', 'pending']
        && data.paymentStatus in ['pending', 'partially_paid', 'paid']
        && (!data.keys().hasAny(['amountPaid']) || data.amountPaid is number)
        && (!data.keys().hasAny(['balance']) || data.balance is number)
        && (!data.keys().hasAny(['customerId']) || (data.customerId is string || data.customerId == null))
        && (!data.keys().hasAny(['customerName']) || data.customerName is string)
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp || data.updatedAt == request.time))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp || data.createdAt == request.time));
    }

    match /invoices/{invoiceId} {
      allow read, get: if isSignedIn();
      allow create: if (isAdmin() || hasPermission('canSell')) && isValidInvoice(incoming());
      allow update: if (isAdmin() || hasPermission('canSell')) && isValidInvoice(incoming());
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // INVENTORY AUDITS
    // ---------------------------------------------------------
    function isValidInventoryAudit(data) {
      return data.keys().hasAll(['userId', 'type', 'status', 'createdAt'])
        && data.userId is string
        && data.type in ['annual', 'monthly', 'weekly', 'spot']
        && data.status in ['draft', 'completed']
        && (!data.keys().hasAny(['items']) || data.items is list)
        && (!data.keys().hasAny(['totalDiscrepancyValue']) || data.totalDiscrepancyValue is number)
        && (!data.keys().hasAny(['completedAt']) || (data.completedAt is timestamp || data.completedAt == request.time))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp || data.createdAt == request.time));
    }

    match /inventory_audits/{auditId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidInventoryAudit(incoming());
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // QUOTES
    // ---------------------------------------------------------
    function isValidQuote(data) {
      return data.keys().hasAll(['quoteNumber', 'userId', 'items', 'totalAmount', 'status', 'createdAt'])
        && data.quoteNumber is string && data.quoteNumber.size() <= 64
        && data.userId is string
        && data.items is list && data.items.size() > 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['draft', 'sent', 'accepted', 'converted', 'expired']
        && (!data.keys().hasAny(['userName']) || data.userName is string)
        && (!data.keys().hasAny(['customerName']) || data.customerName is string)
        && (!data.keys().hasAny(['customerId']) || (data.customerId is string || data.customerId == null))
        && (!data.keys().hasAny(['subtotal']) || data.subtotal is number)
        && (!data.keys().hasAny(['taxAmount']) || data.taxAmount is number)
        && (!data.keys().hasAny(['taxRate']) || data.taxRate is number)
        && (!data.keys().hasAny(['discount']) || data.discount is number)
        && (!data.keys().hasAny(['expiryDate']) || data.expiryDate is timestamp)
        && (!data.keys().hasAny(['notes']) || data.notes is string)
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp || data.createdAt == request.time))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp || data.updatedAt == request.time));
    }

    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidQuote(incoming());
      allow update: if isSignedIn() && isValidQuote(incoming());
      allow delete: if isSignedIn();
    }

    // ---------------------------------------------------------
    // SYSTEM LOGS
    // ---------------------------------------------------------
    match /system_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // ---------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------
    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'isRead', 'priority', 'createdAt'])
        && data.type in ['low_stock', 'stock_discrepancy', 'cash_discrepancy', 'system', 'deletion', 'alert', 'info', 'success', 'warning', 'sale', 'invoice', 'quote', 'user', 'payment', 'security']
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.isRead is bool
        && data.priority in ['low', 'medium', 'high', 'critical']
        && (!data.keys().hasAny(['status']) || data.status in ['read', 'unread', 'archived'])
        && (!data.keys().hasAny(['userId']) || data.userId is string || data.userId == null)
        && (!data.keys().hasAny(['userName']) || data.userName is string || data.userName == null)
        && (!data.keys().hasAny(['triggeredBy']) || data.triggeredBy is string || data.triggeredBy == null)
        && (!data.keys().hasAny(['triggeredByName']) || data.triggeredByName is string || data.triggeredByName == null)
        && (!data.keys().hasAny(['metadata']) || data.metadata is map || data.metadata == null)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time || data.updatedAt is timestamp)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp || data.createdAt == request.time);
    }

    match /notifications/{notificationId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if (isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || !('userId' in existing())))) 
        && isValidNotification(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'status', 'updatedAt']);
      allow delete: if isSignedIn();
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSuperAdmin();
      allow delete: if isSignedIn();
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSuperAdmin();
      allow delete: if isSignedIn();
    }

    match /employeePayments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSuperAdmin();
      allow delete: if isSignedIn();
    }

    match /employeeAttendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /employeeLeaves/{leaveId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /employeeLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /revenues/{revenueId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSuperAdmin() || hasPermission('canManageExpenses');
      allow delete: if isAdmin() || isSuperAdmin();
    }

  }
}
