{
  "entities": {
    "User": {
      "title": "Utilisateur",
      "description": "Profil utilisateur avec rôle RBAC",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "username": { "type": "string", "description": "Identifiant de connexion unique" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "vendeur", "manager"] },
        "permissions": {
          "type": "object",
          "properties": {
            "canManageStock": { "type": "boolean" },
            "canDeleteProducts": { "type": "boolean" },
            "canSell": { "type": "boolean" },
            "canProcessReturns": { "type": "boolean" },
            "canPerformInventory": { "type": "boolean" },
            "canManageExpenses": { "type": "boolean" },
            "canViewReports": { "type": "boolean" }
          }
        },
        "isLocalOnly": { "type": "boolean", "description": "Si vrai, l'utilisateur n'a pas d'email Google" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Produit",
      "description": "Article de l'inventaire",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "minStock": { "type": "number" }
      },
      "required": ["name", "categoryId", "purchasePrice", "sellingPrice", "stockQuantity"]
    },
    "Sale": {
      "title": "Vente",
      "description": "Transaction de vente POS",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "transfer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["completed", "refunded"] }
      },
      "required": ["userId", "items", "totalAmount", "paymentMethod", "createdAt", "status"]
    },
    "Customer": {
      "title": "Client",
      "description": "Fiche client et fidélité",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "clientCode": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "totalSpent": { "type": "number" },
        "totalPaid": { "type": "number" },
        "totalDebt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "totalSpent"]
    },
    "Supplier": {
      "title": "Fournisseur",
      "description": "Fiche fournisseur",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name"]
    },
    "Expense": {
      "title": "Dépense",
      "description": "Charge opérationnelle",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "reason": { "type": "string" },
        "amount": { "type": "number" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "reason", "amount", "userId", "createdAt"]
    },
    "PendingSale": {
      "title": "Vente en instance",
      "description": "Vente suspendue temporairement",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array" },
        "discount": { "type": "number" },
        "subtotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" }
      },
      "required": ["userId", "items", "totalAmount"]
    },
    "StockMovement": {
      "title": "Mouvement de stock",
      "description": "Historique des entrées/sorties",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "quantity", "type", "userId", "createdAt"]
    },
    "DailyClosing": {
      "title": "Sessions de Caisse",
      "description": "Historique des sessions et clôtures de caisse par utilisateur",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "startingCash": { "type": "number", "description": "Fond de caisse au début de journée" },
        "cashSales": { "type": "number" },
        "transferSales": { "type": "number" },
        "totalSales": { "type": "number" },
        "expenses": { "type": "number" },
        "netCash": { "type": "number" },
        "salesCount": { "type": "number" },
        "closedBy": { "type": "string" },
        "closedByName": { "type": "string" },
        "closingNote": { "type": "string" },
        "actualCashInDrawer": { "type": "number" },
        "nextSessionCash": { "type": "number", "description": "Argent laissé pour la session suivante" },
        "difference": { "type": "number" }
      },
      "required": ["date", "userId", "status", "startTime", "startingCash"]
    },
    "InventoryAudit": {
      "title": "Inventaire Physique",
      "description": "Réconciliation périodique du stock (Annuel, Mensuel, Hebdomadaire)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["annual", "monthly", "weekly", "spot"] },
        "status": { "type": "string", "enum": ["draft", "completed"] },
        "items": { "type": "array", "description": "Liste des produits avec stock théorique vs réel" },
        "totalDiscrepancyValue": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "status", "createdAt"]
    },
    "Quote": {
      "title": "Devis",
      "description": "Devis et estimations clients",
      "type": "object",
      "properties": {
        "quoteNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "taxRate": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "accepted", "converted", "expired"] },
        "expiryDate": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quoteNumber", "userId", "items", "totalAmount", "status", "createdAt"]
    },
    "Invoice": {
      "title": "Facture",
      "description": "Factures clients et règlements",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerNIF": { "type": "string" },
        "customerRC": { "type": "string" },
        "customerAI": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "taxRate": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "validated", "paid", "cancelled", "pending"] },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "transfer"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "partially_paid", "paid"] },
        "paymentHistory": { "type": "array" },
        "notes": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "userId", "items", "totalAmount", "status", "paymentStatus", "createdAt"]
    },
    "Settings": {
      "title": "Paramètres Entreprise",
      "description": "Configuration globale de l'application et identité visuelle",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "slogan": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "nif": { "type": "string" },
        "rc": { "type": "string" },
        "ai": { "type": "string" },
        "nis": { "type": "string" },
        "tva": { "type": "string" },
        "useTax": { "type": "boolean" },
        "taxRate": { "type": "number" },
        "footerText": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "lockSessions": { "type": "boolean" }
      },
      "required": ["name", "currency", "currencySymbol"]
    },
    "AppNotification": {
      "title": "Notification",
      "description": "Alertes système et notifications critiques pour les administrateurs",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["low_stock", "stock_discrepancy", "cash_discrepancy", "system", "sale", "invoice", "quote", "user", "deletion", "payment", "security"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["unread", "read", "archived"] },
        "metadata": { "type": "object" },
        "userId": { "type": "string", "description": "ID du destinataire (null pour diffusion admins)" },
        "triggeredBy": { "type": "string" },
        "triggeredByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "message", "isRead", "status", "priority", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Profils utilisateurs" },
    "/products/{productId}": { "schema": "Product", "description": "Articles en stock" },
    "/sales/{saleId}": { "schema": "Sale", "description": "Historique des ventes" },
    "/categories/{categoryId}": { "schema": "object", "description": "Catégories de produits" },
    "/customers/{customerId}": { "schema": "Customer", "description": "Base clients" },
    "/suppliers/{supplierId}": { "schema": "Supplier", "description": "Base fournisseurs" },
    "/stock_movements/{movementId}": { "schema": "StockMovement", "description": "Audit des stocks" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Dépenses" },
    "/pending_sales/{saleId}": { "schema": "PendingSale", "description": "Ventes suspendues" },
    "/daily_closings/{closingId}": { "schema": "DailyClosing", "description": "Clôtures de caisse" },
    "/inventory_audits/{auditId}": { "schema": "InventoryAudit", "description": "Réconciliations de stock" },
    "/quotes/{quoteId}": { "schema": "Quote", "description": "Devis clients" },
    "/invoices/{invoiceId}": { "schema": "Invoice", "description": "Factures clients" },
    "/settings/{settingId}": { "schema": "Settings", "description": "Configuration entreprise" },
    "/notifications/{notificationId}": { "schema": "AppNotification", "description": "Alertes et notifications système" }
  }
}
